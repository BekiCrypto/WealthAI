# Core
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Database (docker-compose provides this out of the box)
DATABASE_URL=postgresql+psycopg2://wealthai:wealthai@localhost:5432/wealthai

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (chat + macro reasoning). Without this, /api/chat falls back to a
# deterministic data summary instead of a narrative answer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Optional data providers -- the app runs fine without these, with reduced
# fidelity (no FRED-backed actuals, geopolitical risk score stays neutral prior).
FRED_API_KEY=
NEWS_API_KEY=
